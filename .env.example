# Canonical URL of the deployed invitation (used for social previews).
NEXT_PUBLIC_SITE_URL=https://your-wedding-site.com

# ── RSVP backend ────────────────────────────────────────────────────────────
# Leave RSVP_WEBHOOK_URL empty to run in DEMO MODE: responses are validated
# but NOT saved, and guests are told so on screen.
#
# Set it to an https endpoint to forward each validated RSVP as JSON
# (e.g. a Google Apps Script web app writing to Google Sheets, Zapier, Make,
# or your own API). See README.md → "RSVP setup".
RSVP_WEBHOOK_URL=

# Optional shared secret, sent as "Authorization: Bearer <secret>" and as a
# "secret" field in the JSON body. Never exposed to the browser.
RSVP_WEBHOOK_SECRET=
